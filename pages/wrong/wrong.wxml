<!--pages/test/test.wxml-->
<view class="page">

</view>
  <view class="padding-top text-center">
    第<text class="text-bold text-xl">{{index+1}}</text>题
    共<text class="text-bold text-xl">{{questionList.length}}</text>题
    <view class="text-sm text-gray">题目ID: {{questionList[index]._id}}</view>
  </view>
  <view class='page__hd padding'>
    <view class="page__title">
      <text class="text-bold" wx:if="{{questionList[index]['true'].length <=1}}">【单选题】</text>
      <text class="text-bold" wx:else>【多选题】</text>
      {{questionList[index].question}}
    </view>
  </view>

  <view class="page__bd">
    <!-- 单选题使用radio-group -->
    <radio-group bindchange="radioChange" wx:if="{{questionList[index]['true'].length <=1 && !showAnswer[index]}}">
      <label class="radio my-choosebox" wx:for="{{questionList[index].option}}" wx:for-index="key" wx:for-item="value" wx:key="index">
        <radio class="radio_right" value="{{key}}" checked="{{questionList[index].checked}}" disabled="{{showAnswer[index]}}"/>
        <text class="margin-left-xs">{{key}} :</text>
        <text class="margin-left-xs">{{value}}</text>
      </label>
    </radio-group>

    <!-- 多选题使用checkbox-group -->
    <checkbox-group bindchange="radioChange" wx:if="{{questionList[index]['true'].length > 1 && !showAnswer[index]}}">
      <label class="radio my-choosebox" wx:for="{{questionList[index].option}}" wx:for-index="key" wx:for-item="value" wx:key="index">
        <checkbox class="radio_right" value="{{key}}" checked="{{questionList[index].checked}}" disabled="{{showAnswer[index]}}"/>
        <text class="margin-left-xs">{{key}} :</text>
        <text class="margin-left-xs">{{value}}</text>
      </label>
    </checkbox-group>

    <!-- 已回答的题目显示 -->
    <view wx:if="{{showAnswer[index]}}">
      <label class="radio my-choosebox" wx:for="{{questionList[index].option}}" wx:for-index="key" wx:for-item="value" wx:key="index"
      style="background-color:{{colorList[index][key]}}">
        <text class="margin-left-xs">{{key}} :</text>
        <text class="margin-left-xs">{{value}}</text>
      </label>
      <view class="padding-sm">
        <text class="text-bold">正确答案: {{questionList[index]['true']}}</text>
      </view>
    </view>
  </view>

  <view class="main">
    <!-- <view class="title">
        <view class="item borderRadius right">
            <image src="/image/right.png" alt class="itemImage"></image>{{questionNumber.right}}
        </view>
        <view class="item borderRadius error">
            <image src="/image/error.png" alt class="itemImage"></image>{{questionNumber.error}}
        </view>
        <view class="item count" bind:tap="changeIndex">
            <image src="/image/count.png" alt class="itemImage"></image>{{(index+1)+ '/'+questionList.length}}
        </view>
    </view> -->

  <view class='page_ft flex padding flex-direction'>
    <button bindtap='confirmAnswer' class="cu-btn bg-red round lg" style="position: relative; left: 0rpx; top: 0rpx">确认本题并查看解析</button>
    <button bindtap='nextSubmit' class="cu-btn bg-red round lg" wx:if="{{index != questionList.length-1}}" style="position: relative; left: 0rpx; margin-top: 30rpx">下一题</button>
    <button bindtap='lastSubmit' class="cu-btn bg-red round lg" wx:if="{{index != 0}}" style="position: relative; margin-top: 30rpx">上一题</button>
    <button bindtap='backToList' class="cu-btn bg-blue round lg" style="position: relative; margin-top: 30rpx">返回错题列表</button>
  </view>

  <view class="page_ft flex padding flex-direction">
    <text wx:if="{{showAnswer[index]}}" style="margin-top: 5%;"> 答案解析：{{questionList[index].results}} </text>
  </view>

  <view class="mw-weixin text-center text-gray padding-top">
    <text class="icon-weixin"></text> 滇金丝猴全境保护网络
  </view>
</view>
