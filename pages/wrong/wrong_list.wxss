.page-subjects {
  padding: 30rpx;
}

.header {
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 30rpx;
  color: #333;
}

.subjects {
  background-color: #fff;
  border-radius: 10rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
  margin-bottom: 30rpx;
}

.subject {
  display: flex;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.subject:last-child {
  border-bottom: none;
}

.sortnum {
  width: 60rpx;
  height: 60rpx;
  background-color: #e54d42;
  color: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  margin-right: 20rpx;
}

.name {
  flex: 1;
  font-size: 30rpx;
  color: #333;
}

.arraw {
  color: #999;
  font-size: 36rpx;
}

.no-wrong {
  background-color: #fff;
  border-radius: 10rpx;
  padding: 60rpx 0;
  text-align: center;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
}

.no-wrong .icon-info {
  font-size: 80rpx;
  margin-bottom: 20rpx;
  display: block;
}

.wrong-questions {
  margin-top: 40rpx;
}

.question-list {
  background-color: #fff;
  border-radius: 10rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
}

.question-item {
  padding: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.question-item:last-child {
  border-bottom: none;
}

.question-id {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 10rpx;
}

.question-preview {
  font-size: 28rpx;
  color: #333;
  line-height: 1.5;
}

.mw-weixin {
  margin-top: 60rpx;
  font-size: 24rpx;
}