<!--pages/admin.wxml-->
<view class="container">
  <!-- 密码验证界面 -->
  <block wx:if="{{!isAuthenticated}}">
    <view class="password-container">
      <view class="password-title">管理员登录</view>
      <input type="password" class="password-input" placeholder="请输入管理员密码" bindinput="inputPassword" />
      <button class="password-button" bindtap="verifyPassword">登录</button>
    </view>
  </block>

  <!-- 管理界面 -->
  <block wx:else>
  <view class="header">
    <view class="title">用户审核管理</view>
    <view class="auto-approve">
      <text>自动审核：</text>
      <switch checked="{{autoApprove}}" bindchange="toggleAutoApprove" color="#07c160"/>
    </view>
  </view>

  <!-- 批量操作区域 -->
  <view class="batch-actions">
    <view class="select-all" bindtap="toggleSelectAll">
      <checkbox checked="{{allSelected}}" style="transform:scale(0.8)" />
      <text>全选</text>
    </view>
    <view class="action-buttons">
      <button class="btn-approve" bindtap="batchApprove" data-approve="{{true}}" disabled="{{selectedUsers.length === 0}}">批量通过</button>
      <button class="btn-reject" bindtap="batchApprove" data-approve="{{false}}" disabled="{{selectedUsers.length === 0}}">批量拒绝</button>
    </view>
  </view>

  <!-- 用户列表 -->
  <view class="user-list">
    <view class="list-header">
      <text class="header-item">选择</text>
      <text class="header-item">姓名</text>
      <text class="header-item">电话</text>
      <text class="header-item">状态</text>
      <text class="header-item">操作</text>
    </view>
    
    <block wx:if="{{loading}}">
      <view class="loading">加载中...</view>
    </block>
    
    <block wx:elif="{{userList.length === 0}}">
      <view class="empty-list">暂无待审核用户</view>
    </block>
    
    <block wx:else>
      <scroll-view scroll-y class="scroll-view">
        <view class="user-item" wx:for="{{userList}}" wx:key="_id">
          <view class="item-select" catchtap="selectUser" data-id="{{item._id}}">
            <checkbox checked="{{selectedUsers.includes(item._id)}}" style="transform:scale(0.8)" />
          </view>
          <view class="item-name">{{item.trueName || '未填写'}}</view>
          <view class="item-phone">{{item.tel || '未填写'}}</view>
          <view class="item-status {{item.checked ? 'status-approved' : 'status-pending'}}">
            {{item.checked ? '已审核' : '待审核'}}
          </view>
          <view class="item-actions">
            <!-- <view class="action-btn-group" wx:if="{{!item.checked}}"> -->
            <view class="action-btn-group">
              <button class="btn-mini btn-approve" catchtap="approveUser" data-id="{{item._id}}" data-approve="{{true}}">通过</button>
              <button class="btn-mini btn-reject" catchtap="approveUser" data-id="{{item._id}}" data-approve="{{false}}">拒绝</button>
            </view>
            <!-- <text wx:if="{{item.checked}}" class="processed-text">已处理</text> -->
          </view>
        </view>
      </scroll-view>
    </block>
  </view>

  <!-- 下拉刷新提示 -->
  <view class="refresh-tip">下拉可刷新用户列表</view>
  </block>
</view>