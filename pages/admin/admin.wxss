/* pages/admin.wxss */
/* 密码验证界面样式 */
.password-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  margin-top: 200rpx;
}

.password-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 40rpx;
}

.password-input {
  width: 80%;
  height: 80rpx;
  border: 2rpx solid #ddd;
  border-radius: 8rpx;
  padding: 0 20rpx;
  margin-bottom: 30rpx;
  font-size: 28rpx;
}

.password-button {
  width: 80%;
  height: 80rpx;
  background-color: #07c160;
  color: #fff;
  border-radius: 8rpx;
  font-size: 30rpx;
  line-height: 80rpx;
  text-align: center;
}

.container {
  padding: 0;
  background-color: #fff;
  /* width:max-content; */
}

.header {
  width: 100%;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 30rpx;
  margin-bottom: 10rpx;
  background-color: #fff;
  box-sizing: border-box;
}

.title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.auto-approve {
  display: flex;
  align-items: center;
}

.auto-approve text {
  margin-right: 8rpx;
  font-size: 26rpx;
}

/* 标签页样式 */
.tab-container {
  display: flex;
  width: 100%;
  background-color: #fff;
  border-bottom: 1rpx solid #eee;
  margin-bottom: 10rpx;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  font-size: 28rpx;
  color: #666;
  position: relative;
}

.tab.active {
  color: #07c160;
  font-weight: bold;
}

.tab.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 25%;
  width: 50%;
  height: 4rpx;
  background-color: #07c160;
}

.batch-actions {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 15rpx 30rpx;
  background-color: #fff;
  margin-bottom: 10rpx;
  box-shadow: 0 1rpx 5rpx rgba(0, 0, 0, 0.05);
}

.select-all {
  display: flex;
  align-items: center;
}

.select-all text {
  margin-left: 6rpx;
  font-size: 26rpx;
}

.action-buttons {
  display: flex;
}

.action-buttons button {
  margin-left: 15rpx;
  font-size: 24rpx;
  padding: 8rpx 25rpx;
  line-height: 1.4;
}

.btn-approve {
  background-color: #07c160;
  color: #fff;
}

.btn-reject {
  background-color: #fa5151;
  color: #fff;
}

.user-list {
  background-color: #fff;
  padding: 15rpx 0;
  box-shadow: 0 1rpx 5rpx rgba(0, 0, 0, 0.05);
  margin-bottom: 10rpx;
}

.list-header {
  display: flex;
  padding: 15rpx 30rpx;
  border-bottom: 1rpx solid #eee;
  font-weight: bold;
  font-size: 26rpx;
  color: #666;
}

.header-item:first-child {
  flex: 0.5;
  text-align: center;
}

.header-item:nth-child(2),
.header-item:nth-child(3),
.header-item:nth-child(4) {
  flex: 1;
  text-align: center;
}

.header-item:last-child {
  flex: 1.5;
  text-align: center;
}

.scroll-view {
  max-height: 850rpx;
}

.user-item {
  display: flex;
  align-items: center;
  padding: 15rpx 30rpx;
  border-bottom: 1rpx solid #eee;
}

.item-select {
  flex: 0.5;
  text-align: center;
  font-size: 26rpx;
}

.item-name, .item-phone, .item-status {
  flex: 1;
  text-align: center;
  font-size: 26rpx;
}

.item-actions {
  flex: 1.5;
  text-align: center;
  font-size: 26rpx;
}

.item-status {
  font-weight: bold;
}

.status-approved {
  color: #07c160;
}

.status-pending {
  color: #fa8c16;
}

.status-rejected {
  color: #fa5151;
}

.action-btn-group {
  display: flex;
  justify-content: center;
}

.btn-mini {
  margin: 0 5rpx;
  font-size: 22rpx;
  padding: 6rpx 15rpx;
  line-height: 1.2;
  min-height: unset;
}

.loading, .empty-list {
  text-align: center;
  padding: 30rpx 0;
  color: #999;
  font-size: 28rpx;
}

.refresh-tip {
  text-align: center;
  padding: 20rpx 0;
  color: #999;
  font-size: 24rpx;
}

/* 修复checkbox点击区域 */
checkbox {
  pointer-events: none;
}