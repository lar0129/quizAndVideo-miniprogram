/* pages/my/profile.wxss */
.container {
  padding: 30rpx;
}

/* 审核状态样式 */
.status-container {
  width: 100%;
  margin-bottom: 30rpx;
}

.status-box {
  padding: 20rpx;
  border-radius: 8rpx;
  text-align: center;
  margin-bottom: 20rpx;
}

.status-approved {
  background-color: rgba(7, 193, 96, 0.1);
  border: 1px solid #07c160;
}

.status-rejected {
  background-color: rgba(250, 81, 81, 0.1);
  border: 1px solid #fa5151;
}

.status-pending {
  background-color: rgba(250, 140, 22, 0.1);
  border: 1px solid #fa8c16;
}

.status-text {
  font-size: 32rpx;
  font-weight: bold;
}

.status-approved .status-text {
  color: #07c160;
}

.status-rejected .status-text {
  color: #fa5151;
}

.status-pending .status-text {
  color: #fa8c16;
}

.avatar-wrapper {
  padding: 0;
  width: 100%;
  height: 200rpx;
  display: flex;
  justify-content: center;
  margin-bottom: 40rpx;
}

.avatar-wrapper button {
  background-color: transparent;
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 0;
  margin: 0;
}

.avatar-wrapper button::after {
  border: none;
}

.avatar {
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
}

.profile-label {
  font-size: 28rpx;
  color: #333;
  margin-right: 20rpx;
}

.input-wrapper {
  display: flex;
  width: 100%;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #eee;
  margin-bottom: 20rpx;
}

.otherprofile {
  flex: 1;
  height: 80rpx;
  font-size: 28rpx;
  text-align: right;
  padding-right: 20rpx;
}

.submit {
  margin-top: 60rpx;
  padding: 0 30rpx;
}

.approval-message {
  margin-top: 60rpx;
  text-align: center;
  color: #07c160;
  font-size: 30rpx;
  font-weight: bold;
}

/* 禁用状态样式 */
button[disabled], input[disabled] {
  color: #999 !important;
  background-color: #f5f5f5 !important;
  border-color: #eee !important;
}
.avatar-wrapper {
    padding: 0; 
    border-radius: 8px;
    margin-top: 20rpx;
    background-color: white;
  }

.input-wrapper {
  padding: 0; 
  height: 100rpx;
  border-radius: 8px;
  margin-top: 20rpx;
  background-color: white;
}
.profile-label{
  float: left;
  /* margin-left: 20rpx; */
  margin-top: 20rpx;
  font-size: 14px;
  color: #646566
}
.otherprofile{
