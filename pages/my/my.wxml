<!--pages/my.wxml-->
<view class="page-info">
    <view class="header">
      <image class="avatarimage" src="{{avatarUrl}}"></image>
      <view class="nickname" > {{nickname}}</view>
    </view>
    <view class="menus">
        <view class="menu" bindtap="bindMyLogin" >
            <view class="left">
            <image class="icon" style="background-color: #eeeeee;" mode="aspectFill" src="../../image/user.png"></image>
            <text class="title">提交审核信息</text>
            </view>
            <view class="arraw">></view>
        </view>  
        <view class="menu" bindtap="bindMyStudy" >
            <view class="left">
            <image class="icon" style="background-color: #eeeeee;" mode="aspectFill" src="http://file.xiaomutong.com.cn/20200206/lookicon.png"></image>
            <text class="title">错题集</text>
            </view>
            <view class="arraw">></view>
        </view>
        <view class="menu" bindtap="bindRank" >
            <view class="left">
            <image class="icon" style="background-color: #eeeeee;" mode="aspectFill" src="http://file.xiaomutong.com.cn/20200206/listicon.png"></image>
            <text class="title">排行榜</text>
            </view>
            <view class="arraw">></view>
        </view>   
        <view class="menu" bindtap="bindAdmin" >
            <view class="left">
            <image class="icon" style="background-color: #eeeeee;" mode="aspectFill" src="http://file.xiaomutong.com.cn/20200206/recordicon.png"></image>
            <text class="title">审核面板</text>
            </view>
            <view class="arraw">></view>
        </view>  
