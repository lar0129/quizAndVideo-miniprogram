<view class="container">
  <!-- 审核状态显示 -->
  <view class="status-container" wx:if="{{checked}}">
    <view class="status-box {{checked === 'approved' ? 'status-approved' : checked === 'rejected' ? 'status-rejected' : 'status-pending'}}">
      <text class="status-text">审核状态：{{checked === 'approved' ? '已通过' : checked === 'rejected' ? '已拒绝' : '审核中'}}</text>
    </view>
  </view>

  <view class="avatar-wrapper"> 
    <button open-type="chooseAvatar" bind:chooseavatar="onChooseAvatar" disabled="{{checked === 'approved'}}">
      <label class="profile-label van-field__label">头像</label>
      <image class="avatar" src="{{avatarUrl}}"></image>
    </button> 
  </view>

  <view class="input-wrapper"> 
    <label class="profile-label" style="position: relative; left: 27rpx; top: 15rpx">昵称</label>
    <input class="otherprofile"
      value="{{ nickname }}"
      label="昵称"
      placeholder="请输入昵称"
      input-align="right"
      type="nickname"
      bindinput="onChangeNickname"
      disabled="{{checked === 'approved'}}"
    />
  </view>

  <view class="input-wrapper"> 
    <label class="profile-label" style="position: relative; left: 27rpx; top: 15rpx">真实姓名</label>
    <input class="otherprofile"
      value="{{ trueName }}"
      label="真实姓名"
      placeholder="真实姓名"
      input-align="right"
      type="trueName"
      bindinput="onChangeTrueName"
      disabled="{{checked === 'approved'}}"
    />
  </view>

  <view class="input-wrapper"> 
    <label class="profile-label" style="position: relative; left: 27rpx; top: 15rpx">电话</label>
    <input class="otherprofile"
      value="{{ tel }}"
      label="电话"
      placeholder="联系电话"
      input-align="right"
      type="tel"
      bindinput="onChangeTel"
      disabled="{{checked === 'approved'}}"
    />
  </view>

  <view class="input-wrapper"> 
    <label class="profile-label" style="position: relative; left: 27rpx; top: 15rpx">公司</label>
    <input class="otherprofile"
      value="{{ company }}"
      label="公司"
      placeholder="公司名称"
      input-align="right"
      type="company"
      bindinput="onChangeCompany"
      disabled="{{checked === 'approved'}}"
    />
  </view>

  <view class="submit" wx:if="{{checked !== 'approved'}}">
    <button type="primary" bindtap="submitUserInfo" size="large">{{checked === 'rejected' ? '重新提交审核' : '提交审核信息'}}</button>
  </view>

  <view class="approval-message" wx:if="{{checked === 'approved'}}">
    <text>您的账号已通过审核，无需再次提交</text>
  </view>
</view>

 

