
<view class="page-subjects">
    <view class="header">请选择题库：</view>
    <view class="subjects">
        <block wx:for="{{subjects}}" wx:key="*this" wx:for-index="idx" wx:for-item="subject">
            <view wx:if="{{subject.typeId<=10}}" class="subject" bindtap="toEntryPage" data-typeId="{{subject.typeId}}" data-id="{{subject._id}}" data-count="{{subject.count}}">
                <view class="sortnum">{{idx+1}}</view>
                <view class="name">{{subject.type}}</view>
                <view class="arraw">></view>
            </view>       
        </block>
    </view>
    <block >
      <view bindtap="goToError">
      <button class='cu-btn bg-red round block lg margin-top' style="width: 80%;margin-left: 10%;">错题回顾</button>
    </view>

    <!-- <view bindtap="goToRank">
      <button class='cu-btn bg-red round block lg margin-top' style="width: 80%;margin-left: 10%;">排行榜</button>
    </view> -->
    </block>
    <view class="mw-weixin text-center text-gray padding-top">
        <text class="icon-weixin"></text> 滇金丝猴全境保护网络
    </view>
</view>