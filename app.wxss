/**app.wxss**/
@import "/style/icon.wxss";
@import "/style/colorui.wxss";
.container {
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: space-between;
  padding: 200rpx 0;
  box-sizing: border-box;
}
.mw-weixin.text-center {
    color: rgb(185, 184, 184);
    padding: 30rpx 0 0;
}
.bg-red {
  background-color: #88358cc5;
  color: #ffffff;
}
.text-red, .line-red, .lines-red {
  color: #88358ca9;
}
.line-red::after, .lines-red::after {
  border-color: #88358ca9;
}

.mw-weixin.text-center {
  color: rgb(182, 182, 182);
  padding: 30rpx 0 0;
}